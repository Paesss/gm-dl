{
  "name": "gm-dl",
  "version": "0.1.0",
  "description": "A lightweight userscript download helper with native GM_download support and a safe XHR fallback.",
  "keywords": [
    "download",
    "userscript",
    "tampermonkey",
    "greasemonkey",
    "xhr",
    "typescript"
  ],
  "homepage": "https://github.com/Paesss/gm-dl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paesss/gm-dl.git"
  },
  "author": {
    "name": "Paesss",
    "url": "https://github.com/Paesss"
  },
  "bugs": {
    "url": "https://github.com/Paesss/gm-dl/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && npm run build:types && npm run build:internal",
    "build:internal": "vite build",
    "build:types": "npm run clean:types && tsc -p tsconfig.types.json && node scripts/rename-types.mjs",
    "clean": "rimraf dist",
    "clean:types": "rimraf dist/types",
    "preview": "vite preview",
    "test": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "^26.4.1",
    "jsdom": "^30.0.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "vite-plugin-monkey": "^8.1.1"
  }
}
